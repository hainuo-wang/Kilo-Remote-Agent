{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "kilo-remote-agent-installer",
  "displayName": "Kilo Remote Agent Installer",
  "description": "Offline installer for the local Controller and Remote SSH components of Kilo Remote Agent.",
  "version": "0.2.0",
  "publisher": "hainuo-wang",
  "icon": "assets/logo-outline-black.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "remote ssh",
    "remote agent",
    "offline installer",
    "offline server",
    "network restricted",
    "no internet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hainuo-wang/Kilo-Remote-Agent.git",
    "directory": "packages/kilo-vscode-remote-installer"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.1"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:kilo-remote-agent-installer.install"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kilo-remote-agent-installer.install",
        "title": "Kilo Remote Agent: Install Components"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "bundle": "node esbuild.js",
    "package": "bun run build && bun script/package.ts",
    "test": "bun test test",
    "check-types": "tsgo --noEmit",
    "typecheck": "bun run check-types"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.105.1",
    "esbuild": "^0.27.2",
    "@typescript/native-preview": "catalog:",
    "@vscode/vsce": "^3.7.1",
    "@tsconfig/bun": "catalog:",
    "typescript": "catalog:"
  }
}
