{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "kilo-remote-agent-controller",
  "displayName": "Kilo Remote Agent Controller",
  "description": "Local model, credential, session, and transport controller for Kilo Remote Agent.",
  "version": "0.2.0",
  "publisher": "hainuo-wang",
  "icon": "assets/logo-outline-black.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "remote ssh",
    "remote agent",
    "local controller",
    "offline server",
    "network restricted"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hainuo-wang/Kilo-Remote-Agent.git",
    "directory": "packages/kilo-vscode-remote-controller"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.1"
  },
  "api": "none",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Kilo Remote Agent Controller",
      "properties": {
        "kilo-code.remoteController.cliPath": {
          "type": "string",
          "description": "Optional local path to the Kilo CLI used by the controller.",
          "scope": "machine"
        },
        "kilo-code.remoteController.proxy": {
          "type": "string",
          "default": "",
          "description": "Optional HTTP proxy used only by the local Kilo controller for model requests. This value is never sent to the remote worker.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "kilo-code.new.remote.runSmoke",
        "title": "Kilo: Run Remote Worker Smoke Test"
      },
      {
        "command": "kilo-code.new.remote.configureDuckcoding",
        "title": "Kilo: Configure Local DuckCoding API Key"
      },
      {
        "command": "kilo-code.new.remote.configureMioffice",
        "title": "Kilo: Configure Local Mioffice API Key (Legacy)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "bundle": "node esbuild.js",
    "prepare:cli": "bun script/package.ts",
    "package": "bun run build && bun run prepare:cli -- --package",
    "test": "bun test test",
    "check-types": "tsgo --noEmit",
    "typecheck": "bun run check-types"
  },
  "dependencies": {
    "@kilocode/kilo-remote-protocol": "workspace:*",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.105.1",
    "@types/ws": "8.18.1",
    "esbuild": "^0.27.2",
    "@typescript/native-preview": "catalog:",
    "@vscode/vsce": "^3.7.1",
    "@tsconfig/bun": "catalog:",
    "typescript": "catalog:"
  }
}
